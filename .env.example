# ===== Server =====
PORT=8000
LOG_LEVEL=info
DATA_DIR=./data

# ===== LLM (OpenAI 兼容协议) =====
# 敏感项（LLM_BASE_URL / LLM_API_KEY）推荐通过环境变量注入：
#   export LLM_BASE_URL=<网关地址> LLM_API_KEY=<密钥>
# 环境变量优先于本文件；本文件仅作为本地开发兜底，已被 gitignore，勿提交真实密钥
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=sk-xxx
LLM_MODEL=qwen3-max

# ===== Embedding (OpenAI 兼容 /v1/embeddings，缺省复用 LLM_* 网关) =====
# EMBEDDING_BASE_URL=
# EMBEDDING_API_KEY=
# 免费本地 demo：先 uv sync --extra demo，然后设置以下三项。
# 首次下载约 90 MB 模型，此后 CPU 本地运行，不需要 embedding API key。
# EMBEDDING_PROVIDER=local
# EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
# EMBEDDING_DIM=512
# 切换模型后使用新的 Qdrant collection 名称，避免与旧向量混用。
EMBEDDING_MODEL=text-embedding-v4

# ===== 向量库 Qdrant（空 = qdrant-client 本地嵌入模式，落盘 DATA_DIR/qdrant） =====
# QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=globex_products

# ===== Reranker（空 = 降级为按向量分排序，rerank_applied=false） =====
# RERANKER_BASE_URL=https://your-reranker-host
# RERANKER_MODEL=qwen3-reranker-8b

# ===== Web 搜索 Tavily（空 = 不注册 web_search_tool） =====
# TAVILY_API_KEY=tvly-xxx

# ===== 可观测（空 = 不启用 TracingMiddleware） =====
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Web evidence is admitted only above the weighted local retrieval cutoff.
WEB_KNOWLEDGE_WEIGHT=0.8
WEB_KB_COLLECTION=globex_web_kb
