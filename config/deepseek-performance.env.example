# Apply alongside your own DeepSeek API credentials; no credentials stored here.
# Measured on official DeepSeek endpoint, local BGE, thinking disabled by llm.py.
# output/metric-targets/parallel-latency-v2: four independent search workers,
# 2 workloads x 2 repeats, serial/parallel; 65.07% worker-phase time reduction.
# Not an end-to-end latency guarantee. Keep retry and failure event reporting on.
LLM_MAX_CONCURRENCY=4
LLM_MIN_INTERVAL_SECONDS=0.1
